{
  "name": "@syncboard/backend",
  "version": "2.0.0",
  "private": true,
  "description": "SyncBoard API and real-time collaboration server",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:rooms": "tsx scripts/migrate-legacy-rooms.ts",
    "dev:memory-db": "tsx scripts/memory-db.ts"
  },
  "dependencies": {
    "@sentry/node": "^11.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@syncboard/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.10",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^5.9.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.3.0",
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.4"
  }
}
