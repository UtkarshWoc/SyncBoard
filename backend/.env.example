# ─── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# LOG_LEVEL=debug
# Set to 1 when running behind one reverse proxy / load balancer (Render, Railway, Nginx)
# so rate limiting sees real client IPs (required on Render).
# TRUST_PROXY=1

# ─── Browser access ────────────────────────────────────────────
# Comma-separated list of allowed web app origins.
CORS_ORIGIN=http://localhost:5173
# Public URL of the web app, used in email links (defaults to the first CORS origin).
# APP_URL=https://syncboard.example.com

# ─── Data ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/syncboard
# Optional. Enables the Socket.IO Redis adapter so you can run several API instances.
# REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────
# Required in production: a random string of 32+ characters, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh-token cookie.
# For local dev / same-origin proxying: use `lax`.
# For split production hosting (e.g. Vercel frontend + Render backend):
#   Set COOKIE_SAMESITE=none, COOKIE_SECURE=true, and leave COOKIE_DOMAIN unset.
#   This enables cross-site refresh cookie transmission with Chrome CHIPS partitioned cookie support.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=

# ─── Email ─────────────────────────────────────────────────────
# Without SMTP_URL, verification and password-reset emails are printed to the server log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="SyncBoard <no-reply@syncboard.local>"

# ─── Observability ─────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Bearer token for GET /metrics (Prometheus). Without it, /metrics is disabled in production.
# METRICS_TOKEN=

# ─── Realtime & history ────────────────────────────────────────
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000
SNAPSHOT_INTERVAL_MINUTES=10
SNAPSHOT_KEEP_AUTO=30

# ─── Local Dev & Testing ───────────────────────────────────────
# MongoDB URI override for running integration tests against an external database.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/syncboard_test
# Port and data directory overrides for `npm run dev:memory-db` (mongodb-memory-server).
# DEV_DB_PORT=27017
# DEV_DB_PATH=

