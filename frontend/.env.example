# Where the API lives. Defaults to same-origin `/api` (Vite proxies it in development;
# in production, proxy /api to the backend from your host — see README — or set a full URL).
# VITE_API_BASE_URL=https://api.syncboard.example.com/api

# Socket.IO server. Defaults to the current origin. Set this in production when the API is on
# another host (most static hosts can't proxy WebSockets).
# VITE_SOCKET_URL=https://api.syncboard.example.com

# Dev only: backend the Vite proxy forwards to.
# VITE_DEV_API_TARGET=http://localhost:5000

VITE_APP_NAME=SyncBoard
VITE_GOOGLE_CLIENT_ID=

# JSON array of RTCIceServer objects for voice/video. A TURN server is needed for users behind
# strict NATs/firewalls (e.g. school networks).
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# VITE_SENTRY_DSN=
